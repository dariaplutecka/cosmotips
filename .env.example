# Copy to .env.local (never commit real secrets).

# Public URL: Stripe redirects, magic links, Google OAuth redirects.
# Must match production domain (https://…).
NEXT_PUBLIC_BASE_URL=

# --- OpenAI (report & tarot generation) ---
OPENAI_API_KEY=

# --- Stripe ---
# test | live — selects STRIPE_SECRET_KEY_TEST vs STRIPE_SECRET_KEY_LIVE
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
# Dashboard → Webhooks → Signing secret (use separate endpoint secret per env: test vs live)
STRIPE_WEBHOOK_SECRET=

# Pro subscription Checkout (monthly/yearly Stripe Price IDs)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Dev only — never enable in production (skips Checkout for reports/tarot when not live)
STRIPE_SKIP_PAYMENT_FOR_DEV=false

# Note: one-off reports and tarot token packs use inline price_data in code (EUR amounts),
# not env Price IDs.

# --- Auth (sessions + magic link + Google) ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional `.example.pl` — same session cookie on www and apex (`resolvedAuthCookieDomain`).
AUTH_COOKIE_DOMAIN=

# Secures /api/cron/* — set the same in Vercel; cron sends Authorization: Bearer …
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Verified domain in Resend recommended for production
REPORT_EMAIL_FROM=
# Where contact form notifications go (fallback in code if unset)
CONTACT_INBOX_EMAIL=

# --- Upstash Redis (sessions, rate limits, tokens, subscription state, idempotency) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
